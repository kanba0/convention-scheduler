  "query": "\n        SELECT a.id, a.kind AS \"kind: AttractionKind\", a.duration_minutes\n        FROM attractions a\n        WHERE a.convention_id = $1\n          AND NOT EXISTS (SELECT 1 FROM slots s WHERE s.attraction_id = a.id)\n        ORDER BY a.title\n        ",
